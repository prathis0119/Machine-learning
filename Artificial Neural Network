        "import numpy as np\n",
        "from sklearn.neural_network import MLPClassifier\n",
        "from sklearn.metrics import accuracy_score\n",
        "\n",
        "# XOR dataset\n",
        "X = np.array([\n",
        "    [0, 0],\n",
        "    [0, 1],\n",
        "    [1, 0],\n",
        "    [1, 1]\n",
        "])\n",
        "\n",
        "y = np.array([0, 1, 1, 0])\n",
        "\n",
        "# Build ANN using Backpropagation\n",
        "ann = MLPClassifier(\n",
        "    hidden_layer_sizes=(4,),\n",
        "    activation='logistic',\n",
        "    solver='lbfgs',\n",
        "    max_iter=5000,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# Train the ANN\n",
        "ann.fit(X, y)\n",
        "\n",
        "# Test the ANN\n",
        "predictions = ann.predict(X)\n",
        "\n",
        "print(\"Actual Output :\", y)\n",
        "print(\"Predicted Output:\", predictions)\n",
        "print(\"Accuracy:\", accuracy_score(y, predictions) * 100, \"%\")"
      ]
    }
