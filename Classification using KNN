        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.datasets import load_iris\n",
        "from sklearn.metrics import accuracy_score, classification_report, confusion_matrix\n",
        "from sklearn.model_selection import GridSearchCV, cross_val_score, train_test_split\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "RANDOM_STATE = 42\n",
        "\n",
        "\n",
        "def load_data():\n",
        "    iris = load_iris(as_frame=True)\n",
        "    X, y = iris.data, iris.target\n",
        "    return X, y, iris.target_names\n",
        "\n",
        "\n",
        "def find_best_k(X_train, y_train, max_k=25):\n",
        "    \"\"\"Cross-validate odd values of k and return the best one with all scores.\"\"\"\n",
        "    scores = {}\n",
        "    for k in range(1, max_k + 1, 2):\n",
        "        pipe = Pipeline([(\"scale\", StandardScaler()),\n",
        "                         (\"knn\", KNeighborsClassifier(n_neighbors=k))])\n",
        "        scores[k] = cross_val_score(pipe, X_train, y_train, cv=5).mean()\n",
        "    best_k = max(scores, key=scores.get)\n",
        "    return best_k, scores\n",
        "\n",
        "\n",
        "def main():\n",
        "    X, y, class_names = load_data()\n",
        "    print(f\"Dataset: {X.shape[0]} samples, {X.shape[1]} features, classes: {list(class_names)}\\n\")\n",
        "\n",
        "    X_train, X_test, y_train, y_test = train_test_split(\n",
        "        X, y, test_size=0.2, stratify=y, random_state=RANDOM_STATE)\n",
        "\n",
        "    # 1. Choose k by cross-validation\n",
        "    best_k, scores = find_best_k(X_train, y_train)\n",
        "    print(\"Cross-validated accuracy for each k:\")\n",
        "    for k, s in scores.items():\n",
        "        print(f\"  k={k:<2d}  {s:.4f}{'  <-- best' if k == best_k else ''}\")\n",
        "    print()\n",
        "\n",
        "    # 2. Optional: tune weights and distance metric as well\n",
        "    grid = GridSearchCV(\n",
        "        Pipeline([(\"scale\", StandardScaler()), (\"knn\", KNeighborsClassifier())]),\n",
        "        param_grid={\n",
        "            \"knn__n_neighbors\": [3, 5, 7, 9, 11],\n",
        "            \"knn__weights\": [\"uniform\", \"distance\"],\n",
        "            \"knn__metric\": [\"euclidean\", \"manhattan\"],\n",
        "        },\n",
        "        cv=5,\n",
        "    )\n",
        "    grid.fit(X_train, y_train)\n",
        "    print(f\"GridSearch best params: {grid.best_params_}  (CV acc {grid.best_score_:.4f})\\n\")\n",
        "\n",
        "    # 3. Final model: scaling + KNN with the best k found above\n",
        "    model = Pipeline([(\"scale\", StandardScaler()),\n",
        "                      (\"knn\", KNeighborsClassifier(n_neighbors=best_k))])\n",
        "    model.fit(X_train, y_train)\n",
        "\n",
        "    # 4. Evaluate\n",
        "    preds = model.predict(X_test)\n",
        "    print(f\"Test accuracy (k={best_k}): {accuracy_score(y_test, preds):.4f}\\n\")\n",
        "    print(\"Classification report:\")\n",
        "    print(classification_report(y_test, preds, target_names=class_names))\n",
        "    print(\"Confusion matrix (rows=true, cols=predicted):\")\n",
        "    print(pd.DataFrame(confusion_matrix(y_test, preds),\n",
        "                       index=class_names, columns=class_names), \"\\n\")\n",
        "\n",
        "    # 5. Predict new flowers\n",
        "    new_flowers = pd.DataFrame(\n",
        "        [[5.1, 3.5, 1.4, 0.2],    # looks like setosa\n",
        "         [6.0, 2.9, 4.5, 1.5],    # looks like versicolor\n",
        "         [6.9, 3.1, 5.8, 2.1]],   # looks like virginica\n",
        "        columns=X.columns)\n",
        "    probs = model.predict_proba(new_flowers)\n",
        "    print(\"Predictions for new flowers:\")\n",
        "    for row, p in zip(new_flowers.values, probs):\n",
        "        label = class_names[np.argmax(p)]\n",
        "        print(f\"  {row.tolist()} -> {label} (confidence {p.max():.0%})\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
