      "source": [
        "import numpy as np\n",
        "from sklearn.mixture import GaussianMixture\n",
        "\n",
        "# Dataset\n",
        "X = np.array([\n",
        "    [1.0], [1.5], [2.0], [2.5], [3.0],\n",
        "    [8.0], [8.5], [9.0], [9.5], [10.0]\n",
        "])\n",
        "\n",
        "# Create EM model\n",
        "model = GaussianMixture(\n",
        "    n_components=2,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# Train the model using EM algorithm\n",
        "model.fit(X)\n",
        "\n",
        "# Predict clusters\n",
        "labels = model.predict(X)\n",
        "\n",
        "# Display results\n",
        "print(\"Cluster Labels:\", labels)\n",
        "print(\"Cluster Means:\")\n",
        "print(model.means_)\n",
        "\n",
        "print(\"Converged:\", model.converged_)\n",
        "print(\"Number of Iterations:\", model.n_iter_)"
      ]
    }
