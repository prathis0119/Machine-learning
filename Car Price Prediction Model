        "import sys\n",
        "import warnings\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "from sklearn.model_selection import cross_val_score, train_test_split\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "TARGET = \"Selling_Price\"\n",
        "CURRENT_YEAR = 2026\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------------------------\n",
        "# 1. Data\n",
        "# ----------------------------------------------------------------------------\n",
        "def make_synthetic_data(n=1500, seed=42):\n",
        "    \"\"\"Generate a realistic demo dataset (prices in lakhs).\"\"\"\n",
        "    rng = np.random.default_rng(seed)\n",
        "    year = rng.integers(2005, 2026, n)\n",
        "    present_price = rng.gamma(3.0, 3.5, n).clip(1.5, 40)        # showroom price\n",
        "    kms = (rng.gamma(2.5, 15000, n) * (CURRENT_YEAR - year + 1) / 8).clip(500, 300000)\n",
        "    fuel = rng.choice([\"Petrol\", \"Diesel\", \"CNG\"], n, p=[0.55, 0.40, 0.05])\n",
        "    seller = rng.choice([\"Dealer\", \"Individual\"], n, p=[0.6, 0.4])\n",
        "    trans = rng.choice([\"Manual\", \"Automatic\"], n, p=[0.8, 0.2])\n",
        "    owner = rng.choice([0, 1, 3], n, p=[0.85, 0.13, 0.02])\n",
        "\n",
        "    age = CURRENT_YEAR - year\n",
        "    price = (\n",
        "        present_price * np.exp(-0.11 * age)\n",
        "        * (1 - 0.0000015 * kms)\n",
        "        * np.where(fuel == \"Diesel\", 1.10, 1.0)\n",
        "        * np.where(trans == \"Automatic\", 1.12, 1.0)\n",
        "        * np.where(seller == \"Individual\", 0.92, 1.0)\n",
        "        * (1 - 0.06 * owner)\n",
        "        * rng.normal(1, 0.06, n)\n",
        "    ).clip(0.2, None)\n",
        "\n",
        "    return pd.DataFrame({\n",
        "        \"Car_Name\": rng.choice([\"swift\", \"city\", \"creta\", \"i20\", \"alto\", \"innova\"], n),\n",
        "        \"Year\": year, \"Selling_Price\": price.round(2), \"Present_Price\": present_price.round(2),\n",
        "        \"Kms_Driven\": kms.round(0), \"Fuel_Type\": fuel, \"Seller_Type\": seller,\n",
        "        \"Transmission\": trans, \"Owner\": owner,\n",
        "    })\n",
        "\n",
        "\n",
        "def load_data(path=None):\n",
        "    if path:\n",
        "        print(f\"Loading dataset from {path} ...\")\n",
        "        path = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] != \"-f\" else None\n",
        "    print(\"No CSV supplied -> generating synthetic demo data.\")\n",
        "    return make_synthetic_data()\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------------------------\n",
        "# 2. Feature engineering\n",
        "# ----------------------------------------------------------------------------\n",
        "def prepare(df):\n",
        "    df = df.copy().drop_duplicates()\n",
        "    df[\"Car_Age\"] = CURRENT_YEAR - df[\"Year\"]\n",
        "    df = df.drop(columns=[\"Year\"])\n",
        "    df = df[df[\"Kms_Driven\"] < df[\"Kms_Driven\"].quantile(0.995)]   # drop extreme outliers\n",
        "    df = df.dropna()\n",
        "    # Car_Name has too many unique values in real data; keep only the brand (first word)\n",
        "    if \"Car_Name\" in df.columns:\n",
        "        df[\"Brand\"] = df[\"Car_Name\"].astype(str).str.split().str[0].str.lower()\n",
        "        df = df.drop(columns=[\"Car_Name\"])\n",
        "    return df\n",
        "\n",
        "\n",
        "def build_preprocessor(X):\n",
        "    num = X.select_dtypes(include=np.number).columns.tolist()\n",
        "    cat = X.select_dtypes(exclude=np.number).columns.tolist()\n",
        "    return ColumnTransformer([\n",
        "        (\"num\", StandardScaler(), num),\n",
        "        (\"cat\", OneHotEncoder(handle_unknown=\"ignore\"), cat),\n",
        "    ])\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------------------------\n",
        "# 3. Train, compare, evaluate\n",
        "# ----------------------------------------------------------------------------\n",
        "def main():\n",
        "    path = sys.argv[1] if len(sys.argv) > 1 else None\n",
        "    df = prepare(load_data(path))\n",
        "    print(f\"Dataset shape: {df.shape}\\n\")\n",
        "\n",
        "    X, y = df.drop(columns=[TARGET]), df[TARGET]\n",
        "    # Predict log-price: prices are right-skewed and errors are proportional\n",
        "    y_log = np.log1p(y)\n",
        "    X_tr, X_te, y_tr, y_te = train_test_split(X, y_log, test_size=0.2, random_state=42)\n",
        "\n",
        "    models = {\n",
        "        \"Linear Regression\": LinearRegression(),\n",
        "        \"Random Forest\": RandomForestRegressor(n_estimators=300, min_samples_leaf=2,\n",
        "                                               n_jobs=-1, random_state=42),\n",
        "        \"Gradient Boosting\": GradientBoostingRegressor(n_estimators=300, learning_rate=0.05,\n",
        "                                                       max_depth=3, random_state=42),\n",
        "    }\n",
        "\n",
        "    results, fitted = [], {}\n",
        "    for name, model in models.items():\n",
        "        pipe = Pipeline([(\"prep\", build_preprocessor(X)), (\"model\", model)])\n",
        "        cv_r2 = cross_val_score(pipe, X_tr, y_tr, cv=5, scoring=\"r2\").mean()\n",
        "        pipe.fit(X_tr, y_tr)\n",
        "        pred = np.expm1(pipe.predict(X_te))            # back to real price scale\n",
        "        actual = np.expm1(y_te)\n",
        "        results.append({\n",
        "            \"Model\": name,\n",
        "            \"CV R2\": round(cv_r2, 4),\n",
        "            \"Test R2\": round(r2_score(actual, pred), 4),\n",
        "            \"MAE\": round(mean_absolute_error(actual, pred), 3),\n",
        "            \"RMSE\": round(np.sqrt(mean_squared_error(actual, pred)), 3),\n",
        "        })\n",
        "        fitted[name] = pipe\n",
        "\n",
        "    table = pd.DataFrame(results).sort_values(\"Test R2\", ascending=False)\n",
        "    print(table.to_string(index=False), \"\\n\")\n",
        "\n",
        "    best_name = table.iloc[0][\"Model\"]\n",
        "    best = fitted[best_name]\n",
        "    print(f\"Best model: {best_name}\")\n",
        "\n",
        "    # Feature importance (tree models)\n",
        "    reg = best.named_steps[\"model\"]\n",
        "    if hasattr(reg, \"feature_importances_\"):\n",
        "        names = best.named_steps[\"prep\"].get_feature_names_out()\n",
        "        imp = pd.Series(reg.feature_importances_, index=names).sort_values(ascending=False)\n",
        "        print(\"\\nTop features:\\n\", imp.head(8).round(4).to_string())\n",
        "\n",
        "    # Predict a new car\n",
        "    new_car = {\n",
        "        \"Present_Price\": 9.5, \"Kms_Driven\": 42000, \"Fuel_Type\": \"Petrol\",\n",
        "        \"Seller_Type\": \"Dealer\", \"Transmission\": \"Manual\", \"Owner\": 0,\n",
        "        \"Car_Age\": 5, \"Brand\": X[\"Brand\"].iloc[0],\n",
        "    }\n",
        "    new_df = pd.DataFrame([new_car])[X.columns]\n",
        "    price = np.expm1(best.predict(new_df))[0]\n",
        "    print(f\"\\nPredicted selling price for the sample car: {price:.2f} lakhs\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
    }
  ]
